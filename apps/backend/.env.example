APP_NAME=Shelf Stock Monitor API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shelf_stock
DATABASE_TEST_NAME=shelf_stock_test
DATABASE_USER=shelf_stock
DATABASE_PASSWORD=change_me

MONITORING_ENABLED=true
MONITORING_INTERVAL_MINUTES=1

NOTIFICATION_PROVIDER=logging

LOW_STOCK_DROP_PERCENTAGE=15
LOW_STOCK_REMINDER_MINUTES=60

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_TIMEOUT_SECONDS=20

MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=shelf-stock-detector-benchmarks

LOGGING_FILE_ENABLED=true
LOGGING_FILE_PATH=logs/backend.log
LOGGING_ROTATION=10 MB
LOGGING_RETENTION=14 days